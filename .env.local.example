# 관리자 로그인 비밀번호 및 세션 서명 키
ADMIN_PASSWORD=ictech2026!
ADMIN_SESSION_SECRET=change-this-to-a-long-random-secret

# 견적·기술 문의 수신 이메일 주소 (기본값: ICTY@ICTECH.CO.KR)
CONTACT_TO_EMAIL=ICTY@ICTECH.CO.KR

# 방법 1: 기업 메일 / 네이버웍스 / 하이웍스 / Gmail SMTP 설정
# 아래 항목을 입력하면 홈페이지 문의 시 즉시 ICTY@ICTECH.CO.KR로 메일이 자동 발송됩니다.
SMTP_HOST=smtp.hiworks.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sender@ictech.co.kr
SMTP_PASS=your-smtp-app-password
SMTP_FROM="아이씨테크 홈페이지 <your-sender@ictech.co.kr>"

# 방법 2 (선택): SMTP 대신 Resend API를 사용할 경우
# RESEND_API_KEY=re_xxxxxxxxxxxxx
